# --- Paperless-ngx connection (required) ---
PAPERLESS_URL=http://localhost:8000
PAPERLESS_TOKEN=

# --- Primary LLM (required) ---
# Any OpenAI-compatible endpoint: OpenAI itself, Gemini's OpenAI-compatible endpoint,
# OpenRouter, a local Ollama/vLLM/llama.cpp server, etc.
OPENAI_COMPATIBLE_API_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_API_KEY=sk-...
OPENAI_COMPATIBLE_MODEL=gpt-4o-mini
# Set to true if the model above accepts image input — enables vision mode, the
# recommended way to OCR + extract metadata in a single call. See README.
OPENAI_COMPATIBLE_VISION=true

# --- Secondary LLM (optional) ---
# Only used as a fallback when a call to the primary endpoint fails.
#OPENAI_COMPATIBLE_SECONDARY_API_URL=http://localhost:11434/v1
#OPENAI_COMPATIBLE_SECONDARY_API_KEY=
#OPENAI_COMPATIBLE_SECONDARY_MODEL=qwen2.5vl
#OPENAI_COMPATIBLE_SECONDARY_VISION=false

# --- Docling (optional) ---
# Only needed if OPENAI_COMPATIBLE_VISION is false — Docling is the non-vision OCR route.
#DOCLING_URL=http://localhost:50000

# --- Behavior ---
#LLM_ANSWER_LANGUAGE=English
#OWN_NAME=
#POLL_INTERVAL_MS=10000
#ALLOW_NEW_CORRESPONDENT=false
#OCR_MODE=auto
#OCR_MIN_CHARS_PER_PAGE=100

# --- Tags ---
#TAG_AI_AUTO=ai-auto
#TAG_AI_OCR_AUTO=ai-ocr-auto
#TAG_AI_OCR_DONE=ai-ocr-done
#TAG_AI_DONE=
#TAG_AI_FAILED=ai-failed
